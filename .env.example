# Leave DATABASE_URL empty to use the encrypted local demo store. Never commit real credentials.
DATABASE_URL=
# Required in production: independent random secrets, at least 32 characters each.
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Session prices use a fixed 20% markup on the therapist charge.
# Leave blank locally; set the exact public HTTPS origin behind a production proxy.
APP_ORIGIN=

# Preview by default: no money can be collected without full merchant setup.
PAYMENTS_MODE=preview
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Server-only JSON map of provider:<id> to approved Razorpay Route linked account.
RAZORPAY_LINKED_ACCOUNTS={}
